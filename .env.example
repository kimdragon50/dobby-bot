# Dobby Bot Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Slack Configuration (REQUIRED)
# ============================================
# Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token (starts with xapp-, requires Socket Mode enabled)
SLACK_APP_TOKEN=xapp-your-app-token

# Signing Secret (from Basic Information > App Credentials)
SLACK_SIGNING_SECRET=your-signing-secret

# ============================================
# Jira Configuration (REQUIRED for Jira features)
# ============================================
# Enable/disable Jira features
JIRA_ENABLED=true

# Your Jira instance URL
JIRA_SERVER_URL=https://your-domain.atlassian.net

# Jira account email
JIRA_USERNAME=your-email@example.com

# Jira API Token (from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token

# ============================================
# AWS Bedrock Configuration (REQUIRED for AI features)
# ============================================
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bedrock Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Model parameters
TEMPERATURE=0.5
MAX_TOKENS=4000

# ============================================
# Slack (Optional)
# ============================================
# Slash command name (e.g. /dobby-test for a staging app)
SLACK_COMMAND=/dobby
# Support channel shown at the bottom of the help message
SUPPORT_CHANNEL_ID=C0123456789

# ============================================
# Bedrock Knowledge Base - RAG (Optional, enables /dobby ask)
# ============================================
KNOWLEDGE_BASE_ID=YOUR_KB_ID

# ============================================
# Bedrock AgentCore - @dobby mention / DM (Optional)
# ============================================
# Supervisor agent runtime ARN (leave empty to disable)
AGENTCORE_SUPERVISOR_ARN=

# ============================================
# Alert Analyze - :op_analyze: (Optional)
# ============================================
# Prometheus / Loki HTTP endpoints (empty = collector skipped)
PROMETHEUS_URL=http://prometheus.example.com
LOKI_URL=http://loki-gateway.example.com
# kubeconfig path (empty = in-cluster config)
KUBECONFIG_PATH=
# Jira project for alert tickets and :op_sre_complete:
OPS_JIRA_PROJECT_KEY=SRE
# Confluence space / parent page for RCA reports (empty = report skipped)
CONFLUENCE_SRE_SPACE_KEY=OPS
CONFLUENCE_ALERT_PARENT_PAGE_ID=123456789

# ============================================
# Weekly Report (Optional)
# ============================================
# Only Jira groups whose name starts with this prefix are listed
JIRA_GROUP_PREFIX=team

# ============================================
# Daily Scrum (Optional)
# ============================================
SCRUM_CHANNEL_TABLE=dobby-scrum-channels
SCRUM_HOUR=9
SCRUM_MINUTE=0
SCRUM_DAYS=mon-fri
SCRUM_SPRINT_ONLY=true
# JQL for the ticket status thread (empty = disabled)
SCRUM_JIRA_JQL=project = PROJ AND sprint in openSprints()

# ============================================
# Langfuse - feedback scores (Optional, all three required)
# ============================================
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
# DynamoDB table holding pending thumbs-down reason prompts
FEEDBACK_PENDING_TABLE=dobby-feedback-pending

# ============================================
# Food Recommendation - Naver Search API (Optional)
# ============================================
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ============================================
# Calendar Briefing - Google service account (Optional)
# ============================================
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# ============================================
# Application Configuration (Optional)
# ============================================
# Environment (development, production)
APP_ENV=development
